<Project>
  <!--
    Shipped inside the Tesserae.Alkove NuGet package and auto-imported by referencing projects
    (buildTransitive/, so transitive consumers get it too). On build it copies the alkove web SDK into
    the Transpose output folder, next to the compiled app, at assets/js/alkove - where AlkoveJs loads
    it from the first time something needs it.

    It is copied rather than embedded as a Transpose resource on purpose - see the note in tps.json.

    The same file serves both consumption models. A package consumer resolves the payload at
    ../alkove inside the restored package. Inside this repo there is no such folder, so it falls back
    to Tesserae.Alkove/assets/js/alkove - the (gitignored) staging output. That lets
    Tesserae.Alkove.Sample import this file directly and exercise exactly the copy a real consumer gets.

    Self-hosting the models (opt-in):

        <PropertyGroup>
          <AlkoveSelfHostModels>true</AlkoveSelfHostModels>
          <AlkoveModels>focus cue</AlkoveModels>   (optional; the default is all five)
        </PropertyGroup>

    downloads the models once per alkove version (from Hugging Face, at the revision the SDK pins,
    sha256-checked by alkove's own `alkove models` command), keeps them under obj/, and copies them to
    assets/js/alkove/models. Call AlkoveJs.UseSelfHostedModels() before the first input so the SDK
    fetches them from there. Needs node on the build machine. Without it the SDK downloads them from
    Hugging Face in the browser - fine for trying it out, and each user then sends Hugging Face their IP.
  -->
  <PropertyGroup>
    <_AlkovePackagedDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)..', 'alkove'))</_AlkovePackagedDir>
    <_AlkoveRepoBundleDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)..', 'assets', 'js', 'alkove'))</_AlkoveRepoBundleDir>
  </PropertyGroup>

  <!--
    After Build, so it lands after the Transpose compiler has written (and possibly cleaned) the output
    folder. Everything is resolved inside the target: $(OutDir) is empty at import time, and on a fresh
    clone the repo bundle does not exist until the referenced project's BundleAlkove target has run.
  -->
  <Target Name="_CopyAlkoveAssets" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_AlkoveSourceDir Condition="Exists('$(_AlkovePackagedDir)')">$(_AlkovePackagedDir)</_AlkoveSourceDir>
      <_AlkoveSourceDir Condition="'$(_AlkoveSourceDir)' == '' and Exists('$(_AlkoveRepoBundleDir)')">$(_AlkoveRepoBundleDir)</_AlkoveSourceDir>
      <AlkoveAssetsOutputDir Condition="'$(AlkoveAssetsOutputDir)' == ''">$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(OutDir)', 'tps', 'assets', 'js', 'alkove'))</AlkoveAssetsOutputDir>
    </PropertyGroup>

    <Error Condition="'$(_AlkoveSourceDir)' == ''"
           Text="Tesserae.Alkove: no alkove distribution found. Looked in '$(_AlkovePackagedDir)' (package) and '$(_AlkoveRepoBundleDir)' (repo). If building this repo from source, run 'npm install &amp;&amp; npm run bundle' in the Tesserae.Alkove folder." />

    <ReadLinesFromFile File="$(_AlkoveSourceDir)version.txt">
      <Output TaskParameter="Lines" PropertyName="_AlkoveVersion" />
    </ReadLinesFromFile>

    <!-- cli.js is the model downloader below: a Node script, never something a page loads. -->
    <ItemGroup>
      <_AlkoveFiles Include="$(_AlkoveSourceDir)**\*" Exclude="$(_AlkoveSourceDir)**\cli.js" />
    </ItemGroup>

    <Copy SourceFiles="@(_AlkoveFiles)"
          DestinationFiles="@(_AlkoveFiles->'$(AlkoveAssetsOutputDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          OverwriteReadOnlyFiles="true" />

    <Message Importance="normal" Text="Tesserae.Alkove: copied alkove $(_AlkoveVersion) from $(_AlkoveSourceDir) to $(AlkoveAssetsOutputDir)" />
  </Target>

  <!--
    AfterTargets rather than a CallTarget from the copy: a called target does not see the properties
    the caller set while running (_AlkoveVersion, _AlkoveSourceDir), one that runs after it does.
  -->
  <Target Name="_AlkoveSelfHostModels" AfterTargets="_CopyAlkoveAssets" Condition="'$(AlkoveSelfHostModels)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_AlkoveModelCache>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)', 'alkove-models', '$(_AlkoveVersion)'))</_AlkoveModelCache>
      <_AlkoveModelMarker>$(_AlkoveModelCache).done-$(AlkoveModels.Replace(' ', '-'))</_AlkoveModelMarker>
      <_AlkoveCli>$(_AlkoveSourceDir)v$(_AlkoveVersion)/cli.js</_AlkoveCli>
    </PropertyGroup>

    <!-- Once per version and model set: the marker is only written after the command succeeded. -->
    <Exec Condition="!Exists('$(_AlkoveModelMarker)')" Command="node &quot;$(_AlkoveCli)&quot; models &quot;$(_AlkoveModelCache.TrimEnd('\').TrimEnd('/'))&quot; $(AlkoveModels)" />
    <Touch Condition="!Exists('$(_AlkoveModelMarker)')" Files="$(_AlkoveModelMarker)" AlwaysCreate="true" />

    <ItemGroup>
      <_AlkoveModelFiles Include="$(_AlkoveModelCache)*.alk" />
    </ItemGroup>

    <Copy SourceFiles="@(_AlkoveModelFiles)" DestinationFolder="$(AlkoveAssetsOutputDir)models" SkipUnchangedFiles="true" />

    <Message Importance="normal" Text="Tesserae.Alkove: self-hosted @(_AlkoveModelFiles->Count()) model(s) in $(AlkoveAssetsOutputDir)models" />
  </Target>
</Project>
