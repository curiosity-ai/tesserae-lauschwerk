<Project Sdk="Transpose.Build.Target/26.10.6986">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <DefineConstants>TRANSPOSE</DefineConstants>
    <AssemblyName>Tesserae.Alkove</AssemblyName>
    <RootNamespace>Tesserae.Alkove</RootNamespace>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <SkipResourcesExtraction>true</SkipResourcesExtraction>
    <MinifyLocalVariables>true</MinifyLocalVariables>
    <!-- A library, not a runnable site: tps emits a chunk map and defers the chunks, so an
         application that references this package but never opens a microphone never fetches them. -->
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Transpose.BCL" Version="26.10.7126" />
    <PackageReference Include="Transpose.Core" Version="26.10.6989" />
    <PackageReference Include="Tesserae" Version="2026.10.72651" />
  </ItemGroup>

  <PropertyGroup>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <Copyright>(c) Copyright 2026 Curiosity GmbH - all right reserved</Copyright>
    <Company>Curiosity GmbH</Company>
    <Authors>Curiosity GmbH</Authors>
    <PackageProjectUrl>https://github.com/theolivenbaum/alkove</PackageProjectUrl>
    <PackageId>Tesserae.Alkove</PackageId>
    <Description>Tesserae.Alkove is a Tesserae (Transpose C# to JavaScript) wrapper around the alkove web SDK: on-device voice isolation, voice activity, wake words and voiceprints in the browser, as typed C# and ready-made Tesserae components.</Description>
    <PackageTags>transpose, HTML, UI, components, voice, speech, audio, vad, wake-word, voiceprint, noise-suppression, webrtc, tesserae, alkove</PackageTags>
    <NoWarn>1701;1702;1591</NoWarn>
    <!-- alkove's code and weights are Apache-2.0, and this wrapper follows it. -->
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="buildTransitive/Tesserae.Alkove.targets" Pack="true" PackagePath="buildTransitive/" />
  </ItemGroup>

  <!--
    alkove is built from source, from sdk/ - the engine, the core and the web SDK copied out of
    .reference/ (which keeps upstream's copy to diff against):

      BuildAlkoveSdk   cargo -> alkove-engine.wasm (wasm32, SIMD, the pinned toolchain in
                       sdk/rust-toolchain.toml), then esbuild -> the SDK's dist/ - upstream's own
                       sdk/packages/alkove/scripts/build.mjs, unchanged
      BundleAlkove     stages that dist into assets/js/alkove (build/bundle-alkove.mjs)

    /p:AlkoveSource=npm stages the pinned npm release (package.json here) instead, for a machine without
    Rust. For 0.3.2 both are byte-identical. Nothing built is committed: dist/, target/ and assets/ are
    gitignored.
  -->
  <PropertyGroup>
    <AlkoveSource Condition="'$(AlkoveSource)' == ''">source</AlkoveSource>
    <AlkoveBundleDir>$(MSBuildProjectDirectory)/assets/js/alkove</AlkoveBundleDir>
    <AlkoveSdkDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '..', 'sdk'))</AlkoveSdkDir>
    <AlkoveSdkPackageDir>$(AlkoveSdkDir)packages/alkove</AlkoveSdkPackageDir>
  </PropertyGroup>

  <ItemGroup>
    <_AlkoveSdkInputs Include="$(AlkoveSdkDir)crates/**/*.rs;$(AlkoveSdkDir)crates/**/Cargo.toml;$(AlkoveSdkDir)crates/core/models.json;$(AlkoveSdkDir)Cargo.toml;$(AlkoveSdkDir)rust-toolchain.toml" />
    <_AlkoveSdkInputs Include="$(AlkoveSdkPackageDir)/src/**/*.ts;$(AlkoveSdkPackageDir)/scripts/*.mjs;$(AlkoveSdkPackageDir)/package.json" />
  </ItemGroup>

  <Target Name="BuildAlkoveSdk" Condition="'$(AlkoveSource)' == 'source'" Inputs="@(_AlkoveSdkInputs)" Outputs="$(AlkoveSdkPackageDir)/dist/alkove-engine.wasm">
    <Exec Command="cargo --version" ConsoleToMSBuild="true" ContinueOnError="true">
      <Output TaskParameter="ExitCode" PropertyName="_AlkoveCargoExit" />
    </Exec>
    <Error Condition="'$(_AlkoveCargoExit)' != '0'" Text="Tesserae.Alkove: building alkove from source needs Rust (rustup installs the toolchain sdk/rust-toolchain.toml pins, with the wasm32 target). Without it, build with /p:AlkoveSource=npm to stage the published release." />
    <Exec Condition="!Exists('$(AlkoveSdkPackageDir)/node_modules')" Command="npm ci --no-audit --no-fund" WorkingDirectory="$(AlkoveSdkPackageDir)" />
    <Exec Command="node scripts/build.mjs" WorkingDirectory="$(AlkoveSdkPackageDir)" />
  </Target>

  <Target Name="BundleAlkove" BeforeTargets="BeforeBuild" DependsOnTargets="BuildAlkoveSdk" Inputs="package.json;build/bundle-alkove.mjs;$(AlkoveSdkPackageDir)/dist/alkove-engine.wasm" Outputs="$(AlkoveBundleDir)/version.txt">
    <Exec Condition="'$(AlkoveSource)' == 'npm'" Command="npm install --no-audit --no-fund" WorkingDirectory="$(MSBuildProjectDirectory)" />
    <Exec Condition="'$(AlkoveSource)' == 'npm'" Command="npm run bundle -- npm" WorkingDirectory="$(MSBuildProjectDirectory)" />
    <Exec Condition="'$(AlkoveSource)' != 'npm'" Command="npm run bundle" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

  <!--
    Resolved in a target rather than a static ItemGroup so the glob runs after BundleAlkove has
    produced the files, and hooked on _GetPackageFiles, where NuGet collects Pack="true" items
    (GenerateNuspec is too late - see tesserae-pdf's csproj for the same note).
  -->
  <Target Name="IncludeAlkoveInPackage" BeforeTargets="_GetPackageFiles" DependsOnTargets="BundleAlkove">
    <ItemGroup>
      <None Include="$(AlkoveBundleDir)/**" Pack="true" PackagePath="alkove/" />
    </ItemGroup>
  </Target>
</Project>
