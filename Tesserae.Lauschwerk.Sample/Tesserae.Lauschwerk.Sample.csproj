<Project Sdk="Transpose.Build.Target/26.10.6986">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <DefineConstants>TRANSPOSE</DefineConstants>
    <AssemblyName>app</AssemblyName>
    <RootNamespace>Tesserae.Lauschwerk.Sample</RootNamespace>
    <MinifyLocalVariables>true</MinifyLocalVariables>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Transpose.BCL" Version="26.10.7126" />
    <PackageReference Include="Transpose.Core" Version="26.10.6989" />
    <PackageReference Include="Tesserae" Version="2026.10.72651" />
    <PackageReference Include="Tesserae.Themes.Curiosity" Version="26.10.72651" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tesserae.Lauschwerk\Tesserae.Lauschwerk.csproj" />
  </ItemGroup>

  <!--
    The speech recordings the gallery plays to the models, synthesized by tools/Lauschwerk.TestAudio.
    Safe alongside the compiler's own output cleaning, which tps.json scopes to "*.js|*.css".
  -->
  <Target Name="_CopySampleAudio" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_SampleAudio Include="assets\audio\**\*" />
    </ItemGroup>

    <Copy SourceFiles="@(_SampleAudio)"
          DestinationFiles="@(_SampleAudio->'$(OutDir)tps\assets\audio\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
