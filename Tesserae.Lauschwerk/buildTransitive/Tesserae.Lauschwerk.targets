<Project>
  <!--
    Shipped inside the Tesserae.Lauschwerk NuGet package and auto-imported by referencing projects
    (buildTransitive/, so transitive consumers get it too). On build it copies the lauschwerk web SDK into
    the Transpose output folder, next to the compiled app, at assets/js/lauschwerk - where LauschwerkJs loads
    it from the first time something needs it.

    It is copied rather than embedded as a Transpose resource on purpose - see the note in tps.json.

    The same file serves both consumption models. A package consumer resolves the payload at
    ../lauschwerk inside the restored package. Inside this repo there is no such folder, so it falls back
    to Tesserae.Lauschwerk/assets/js/lauschwerk - the (gitignored) staging output. That lets
    Tesserae.Lauschwerk.Sample import this file directly and exercise exactly the copy a real consumer gets.

    The five models (7.5 MB) are part of the payload, in models/, so they are copied too and the SDK loads them
    from assets/js/lauschwerk/models by default (LauschwerkJs.ModelBaseUrl): the visitor's browser never talks to a
    third party. Set LauschwerkJs.ModelBaseUrl to serve them from somewhere else.
  -->
  <PropertyGroup>
    <_LauschwerkPackagedDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)..', 'lauschwerk'))</_LauschwerkPackagedDir>
    <_LauschwerkRepoBundleDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)..', 'assets', 'js', 'lauschwerk'))</_LauschwerkRepoBundleDir>
  </PropertyGroup>

  <!--
    After Build, so it lands after the Transpose compiler has written (and possibly cleaned) the output
    folder. Everything is resolved inside the target: $(OutDir) is empty at import time, and on a fresh
    clone the repo bundle does not exist until the referenced project's BundleLauschwerk target has run.
  -->
  <Target Name="_CopyLauschwerkAssets" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_LauschwerkSourceDir Condition="Exists('$(_LauschwerkPackagedDir)')">$(_LauschwerkPackagedDir)</_LauschwerkSourceDir>
      <_LauschwerkSourceDir Condition="'$(_LauschwerkSourceDir)' == '' and Exists('$(_LauschwerkRepoBundleDir)')">$(_LauschwerkRepoBundleDir)</_LauschwerkSourceDir>
      <LauschwerkAssetsOutputDir Condition="'$(LauschwerkAssetsOutputDir)' == ''">$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(OutDir)', 'tps', 'assets', 'js', 'lauschwerk'))</LauschwerkAssetsOutputDir>
    </PropertyGroup>

    <Error Condition="'$(_LauschwerkSourceDir)' == ''"
           Text="Tesserae.Lauschwerk: no lauschwerk distribution found. Looked in '$(_LauschwerkPackagedDir)' (package) and '$(_LauschwerkRepoBundleDir)' (repo). If building this repo from source, run 'npm install &amp;&amp; npm run bundle' in the Tesserae.Lauschwerk folder." />

    <ReadLinesFromFile File="$(_LauschwerkSourceDir)version.txt">
      <Output TaskParameter="Lines" PropertyName="_LauschwerkVersion" />
    </ReadLinesFromFile>

    <!-- cli.js is the model downloader below: a Node script, never something a page loads. -->
    <ItemGroup>
      <_LauschwerkFiles Include="$(_LauschwerkSourceDir)**\*" Exclude="$(_LauschwerkSourceDir)**\cli.js" />
    </ItemGroup>

    <Copy SourceFiles="@(_LauschwerkFiles)"
          DestinationFiles="@(_LauschwerkFiles->'$(LauschwerkAssetsOutputDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          OverwriteReadOnlyFiles="true" />

    <Message Importance="normal" Text="Tesserae.Lauschwerk: copied lauschwerk $(_LauschwerkVersion) from $(_LauschwerkSourceDir) to $(LauschwerkAssetsOutputDir)" />
  </Target>
</Project>
