{
    // One ES module per chunk plus an entry module, the shape every Tesserae/Curiosity front-end is
    // built as. Because this project is IsPackable, tps publishes a chunk map rather than an entry that
    // imports every chunk, so an application that references the package but never opens a microphone
    // never fetches its JavaScript. A Debug build ignores this and emits one readable bundle.
    "outputBy": "Module",

    // NOTE: the compiled output of this project needs no "resources" entry - every variant of it is
    // embedded automatically for a packable project.
    //
    // The lauschwerk SDK (the versioned v<version>/ folder, lauschwerk.js, the models) is a resource, and a
    // copy-through one: no name ending in .js, so nothing is concatenated or renamed, and "load": false, so
    // no <script> is injected - lauschwerk is loaded on demand, its entry is an ES module, and its worker and
    // AudioWorklet are created by the SDK itself. "**" keeps the folder structure and finds the versioned
    // folder without naming the version; every file keeps the name npm shipped it under, which the SDK's
    // chunks import and its worker and worklet are loaded by.
    //
    // It used to be left out of tps.json and copied by an MSBuild target in buildTransitive/, which works
    // only for a build that runs MSBuild. A build that does not - the in-process compiler behind a Curiosity
    // workspace's own front-end - shipped a site with no assets/js/lauschwerk, so the first microphone input
    // was a 404. A resource is carried by the compiler itself, so every way of building a site gets it. The
    // folder is generated (BundleLauschwerk, gitignored); cli.js, the Node model downloader, is never staged.
    "resources": [
        {
            "name": "lauschwerk",
            "files": [ "assets/js/lauschwerk/**" ],
            "output": "assets/js/lauschwerk/",
            "load": false
        }
    ],

    "cleanOutputFolderBeforeBuildPattern": "*.*",
    "loader": {
        "type": "Global"
    },
    "generateTypeScript": false,
    "generateDocumentation": "None",
    "rules": {
        "anonymousType": "Plain",
        "arrayIndex": "Managed",
        "autoProperty": "Plain",
        "boxing": "Managed",
        "externalCast": "Plain",
        "inlineComment": "Plain",
        "integer": "Managed",
        "lambda": "Plain",
        "useShortForms": true
    },
    "sourceMap": {
        "enabled": false
    }
}
