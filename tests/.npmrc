; Supply-chain cooldown: only versions published more than 7 days ago are installable, so a
; compromised release has a week to be caught and unpublished before it can reach this build.
;
; Requires npm >= 11.10.0 - older npm (10.x here) accepts the key silently and ignores it, with no
; warning and no resolution change, so this is inert rather than broken on an old client.
;
; Only `npm install` resolution is affected. `npm ci` installs the exact versions in
; package-lock.json, so the window never applies there. lauschwerk is pinned exactly, and has no
; runtime dependencies of its own.
min-release-age=7
