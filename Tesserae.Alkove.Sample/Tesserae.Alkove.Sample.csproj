<Project Sdk="Transpose.Build.Target/26.10.6986">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <DefineConstants>TRANSPOSE</DefineConstants>
    <AssemblyName>app</AssemblyName>
    <RootNamespace>Tesserae.Alkove.Sample</RootNamespace>
    <MinifyLocalVariables>true</MinifyLocalVariables>

    <!-- The gallery hosts its own models (assets/js/alkove/models), as a production app should: the
         visitor's browser then talks to this site only, never to Hugging Face. Downloaded once per
         alkove version into obj/ by Tesserae.Alkove.targets. -->
    <AlkoveSelfHostModels>true</AlkoveSelfHostModels>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Transpose.BCL" Version="26.10.7126" />
    <PackageReference Include="Transpose.Core" Version="26.10.6989" />
    <PackageReference Include="Tesserae" Version="2026.10.72651" />
    <PackageReference Include="Tesserae.Themes.Curiosity" Version="26.10.72651" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tesserae.Alkove\Tesserae.Alkove.csproj" />
  </ItemGroup>

  <!--
    A PackageReference would get this automatically (it lives in the package's buildTransitive/), but
    a ProjectReference does not import the referenced project's targets - so the sample imports it by
    hand. This is the same file a real consumer runs, which is the point: the sample exercises the
    actual asset copy (and the model self-hosting) rather than a bespoke one.
  -->
  <Import Project="..\Tesserae.Alkove\buildTransitive\Tesserae.Alkove.targets" />

  <!--
    The speech recordings the gallery plays to the models, synthesized by tools/Alkove.TestAudio.
    Safe alongside the compiler's own output cleaning, which tps.json scopes to "*.js|*.css".
  -->
  <Target Name="_CopySampleAudio" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_SampleAudio Include="assets\audio\**\*" />
    </ItemGroup>

    <Copy SourceFiles="@(_SampleAudio)"
          DestinationFiles="@(_SampleAudio->'$(OutDir)tps\assets\audio\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
